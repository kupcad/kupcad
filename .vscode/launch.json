{
  // F5 runs the extension from this checkout in a window of its own (an Extension Development
  // Host), on the examples, with the kupcad this checkout builds (core/zig-out/bin/kupcad).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KupCAD extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/kupcad-vscode",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/packages/kupcad-vscode/dist/**/*.cjs"],
      "preLaunchTask": "kupcad: build the extension and kupcad"
    }
  ]
}
