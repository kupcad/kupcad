# Classes, inheritance, modules and their constants, and the ways to reach them.

module Units
  MM = 1.0
  INCH = 25.4

  def self.to_mm(value, unit)
    value * (unit == :inch ? INCH : MM)
  end
end

class Part
  attr_accessor(:name)
  attr_reader(:size)

  @@count = 0

  def initialize(name, size)
    @name = name
    @size = size
    @@count += 1
  end

  def self.count
    @@count
  end

  def volume
    @size ** 3
  end

  def to_s
    "#{@name} (#{self.volume})"
  end
end

class Bolt < Part
  HEAD = 1.5

  def initialize(size)
    super("bolt", size)
  end

  def volume
    super + HEAD
  end
end

class << Part
  def describe
    "parts: #{self.count}"
  end
end

bolt = Bolt.new(2)
plain = Part.new("plate", 3)
plain.name = "base plate"
checks = [defined?(bolt), defined?(missing), bolt.is_a?(Part), Bolt::HEAD, Units::INCH]
inspect(bolt.to_s, plain.name, plain.size, Part.count, Part.describe, Units.to_mm(2, :inch), checks)
