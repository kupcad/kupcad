plate = cube(10).translate(5, 0, 0) # Manifold: fine

CAD.with_config(engine: :brep) do
  tile = cube(4)
  tile.volume                       # B-Rep inside the block
  CAD.with_config(engine: :manifold) do
    cube(2).rotate(0, 0, 45)        # Manifold again inside
  end
end

CAD.config(engine: :brep)
peg = cylinder(r: 2, h: 10)         # B-Rep has cylinders
cone = cylinder(h: 5, r1: 3, r2: 1)
ball = sphere(r: 3)
[plate, peg.translate(1, 0, 0), cone, ball]

# A method runs under the engine of its call: reported where it is called.
def bracket(n)
  cube(n).translate(1, 0, 0)
end

def plate(n)
  bracket(n)                        # through another method
end

def scoped_part
  CAD.with_config(engine: :brep) do
    cube(2).rotate(0, 0, 45)        # the method sets the engine itself
  end
end

holder = plate(4)

# Booleans on shapes, whatever operator writes them.
box = cube(10)
hole = cylinder(r: 2, h: 20)
cut = box - hole
joined = box + cube(2).extrude(1)   # a solid on either side is enough
profile = square(4) - circle(r: 1)
count = 2 - 1                       # numbers: not a boolean

# A class of the script's own may name its methods like the kernel's: nothing to report.
class Gear
  def volume
    42
  end

  def translate(dx)
    dx
  end
end
gear = Gear.new
teeth = gear.volume + gear.translate(1)
[cut, joined, profile, count, holder, scoped_part, teeth]
