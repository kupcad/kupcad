# kupcad:disable param-order -- this file reads params before defining them
early = param(:width)
width = param(:width, default: 10)

# kupcad:disable-next-line unused-variable
spare = 1
also_spare = 2 # kupcad:disable-line unused-variable -- kept for the next revision

# Hides the next line only: `loose` is still reported.
# kupcad:disable-next-line unused-variable
hidden = 3
loose = 4

# A directive that hides nothing, a rule that doesn't exist, a mistyped directive.
# kupcad:disable-next-line self-subtraction
part = cube(width + early)
# kupcad:disable-next-line unused-varable
# kupcad:disable-nextline unused-variable
# kupcad:disable-line
