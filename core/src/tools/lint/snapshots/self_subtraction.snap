--- after --fix (5 fixed) ---
plate = cube(10)
hole = cylinder(r: 2, h: 20)
_empty = plate - plate
_part = plate - hole
profile = square(4)
_flat = (profile) - profile
_gone = plate.difference(plate)
_kept = plate.difference(hole)
n = 5
zero = n - n
