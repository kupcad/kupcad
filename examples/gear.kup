# examples/advanced_modifiers.kup

# 1. 2D Offsets & Booleans
# Create a seamlessly rounded hollow tube using offsets
outer_profile = square(size: 40, center: true).offset(5)  # Expands and rounds corners
inner_profile = square(size: 36, center: true).offset(3)
wall_profile = outer_profile - inner_profile              # 2D Difference!

# 2. Extrude into a 3D wall
walls = wall_profile.extrude(25)

# 3. Create a solid base plate that matches the outer profile
base = outer_profile.extrude(4).translate(0, 0, -2)

# 4. Minkowski Sum for Soft Feet
# We use Minkowski to sweep a sphere around a thin cube,
# resulting in a perfectly filleted/pillowed rectangular foot pad.
foot_base = cube(x: 30, y: 30, z: 1, center: true)
rounder = sphere(r: 3)
soft_feet = foot_base.minkowski(rounder).translate(0, 0, -4)

# Combine everything
final_enclosure = walls + base + soft_feet

puts("--- Enclosure Specifications ---")
p("Volume:", final_enclosure.volume().round(2))
p("Bounding Box:", final_enclosure.bbox())

final_enclosure
