{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "oxc", "unicorn", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    // Meant for window.postMessage: a Worker's and a MessagePort's take no target origin
    "unicorn/require-post-message-target-origin": "off",
    // A stylesheet is imported for what it does to the page
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "env": {
    "es2024": true
  },
  "ignorePatterns": ["**/dist/**", "**/dist-webview/**"],
  "overrides": [
    {
      // @kupcad/ui/viewer is for any host: none of the package's Svelte, nor the rest of it
      "files": ["packages/kupcad-ui/src/viewer/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["svelte", "svelte/*", "*.svelte", "../*", "@kupcad/ui", "@kupcad/ui/*"],
                "message": "@kupcad/ui/viewer is for any host: it imports neither Svelte nor the rest of @kupcad/ui"
              }
            ]
          }
        ]
      }
    }
  ]
}
