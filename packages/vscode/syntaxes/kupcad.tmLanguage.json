{
  "name": "KupCAD",
  "scopeName": "source.kupcad",
  "patterns": [
    {
      "include": "#docstring"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#method_declarations"
    },
    {
      "include": "#hash_keys"
    },
    {
      "include": "#block_parameters"
    },
    {
      "include": "#symbols"
    },
    {
      "include": "#instance_vars"
    },
    {
      "include": "#global_vars"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#method_calls"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#core_methods"
    },
    {
      "include": "#primitives_3d"
    },
    {
      "include": "#primitives_2d"
    },
    {
      "include": "#transforms"
    },
    {
      "include": "#csg_operators"
    },
    {
      "include": "#workplanes"
    },
    {
      "include": "#inspections"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "docstring": {
      "match": "^\\s*(#\\s*@[a-zA-Z_]+)(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.directive.kupcad"
        },
        "2": {
          "name": "comment.block.documentation.kupcad"
        }
      }
    },
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.kupcad"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.kupcad",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.kupcad"
        },
        {
          "begin": "#\\{",
          "end": "\\}",
          "name": "meta.embedded.line.kupcad",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "symbols": {
      "match": "(?<!:):[a-zA-Z_]\\w*[!?]?",
      "name": "constant.language.symbol.kupcad"
    },
    "numbers": {
      "match": "\\b(0[xX][a-fA-F0-9_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][-+]?[0-9_]+)?)\\b",
      "name": "constant.numeric.kupcad"
    },
    "instance_vars": {
      "match": "(@)[a-zA-Z_]\\w*",
      "name": "variable.other.readwrite.instance.kupcad"
    },
    "global_vars": {
      "match": "(\\$)[a-zA-Z_]\\w*",
      "name": "variable.other.readwrite.global.kupcad"
    },
    "constants": {
      "match": "\\b[A-Z]\\w*\\b",
      "name": "entity.name.type.class.kupcad"
    },
    "operators": {
      "patterns": [
        {
          "match": "(&\\.)",
          "name": "keyword.operator.safe-navigation.kupcad"
        },
        {
          "match": "(<<=|>>=|\\*\\*=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|&&=\\|\\|=)",
          "name": "keyword.operator.assignment.augmented.kupcad"
        },
        {
          "match": "(==|!=|<=|>=|<|>|<=>|===)",
          "name": "keyword.operator.comparison.kupcad"
        },
        {
          "match": "(&&|\\|\\||!)",
          "name": "keyword.operator.logical.kupcad"
        },
        {
          "match": "(\\+|-|\\*|/|%|\\*\\*|&|\\||\\^|<<|>>)",
          "name": "keyword.operator.arithmetic.kupcad"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.kupcad"
        }
      ]
    },
    "method_calls": {
      "match": "([a-zA-Z_]\\w*[!?]?)(\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.kupcad"
        }
      }
    },
    "keywords": {
      "match": "(?<![\\\\w.])(if|or|do|end|not|def|nil|and|next|with|from|true|else|self|when|case|then|super|until|break|while|yield|elsif|false|class|begin|return|module|unless|rescue|ensure|export|import|public|private)(?![\\\\w?!])",
      "name": "keyword.control.kupcad"
    },
    "builtins": {
      "match": "(?<![\\\\w])(puts|print|inspect|debugger|param|import_stl|export_stl|import_step|export_step|export_gltf)(?![\\\\w?!])",
      "name": "support.function.builtin.kupcad"
    },
    "core_methods": {
      "match": "(?<![\\\\w])(is_a?|responds_to?|nil?|empty?|tap|into|dup|clone|length|size|push|pop|shift|unshift|slice|join|each|map|filter|reduce|first|last|contains?|flatten|max|min|sum|keys|values|has_key?|delete|each|empty?|get|merge|symbolize_keys|stringify_keys|upcase|downcase|split|replace|to_f|to_i|trim|starts_with?|ends_with?|to_sym|to_s|to_s|to_i|to_f|round|ceil|floor|abs|to_s|to_sym|to_s|inspect|to_i|to_f|invert|sin|cos|tan|asin|acos|atan2|sqrt|abs|round|ceil|floor|deg2rad|rad2deg|min|max|clamp|lerp|hypot|sign|collect|bytes_allocated)(?![\\\\w?!])",
      "name": "support.function.core.kupcad"
    },
    "primitives_3d": {
      "match": "(?<![\\\\w])(cube|cylinder|sphere|polyhedron)(?![\\\\w?!])",
      "name": "support.class.primitive.3d.kupcad"
    },
    "primitives_2d": {
      "match": "(?<![\\\\w])(square|circle|polygon|text)(?![\\\\w?!])",
      "name": "support.class.primitive.2d.kupcad"
    },
    "transforms": {
      "match": "(?<![\\\\w])(translate|rotate|scale|resize|project|slice|mirror|extrude|revolve|hull|trim_by_plane|minkowski|offset|transform|material|highlight|ghost)(?![\\\\w?!])",
      "name": "support.function.transform.kupcad"
    },
    "csg_operators": {
      "match": "(?<![\\\\w])(union|difference|intersection)(?![\\\\w?!])",
      "name": "support.function.csg.kupcad"
    },
    "workplanes": {
      "match": "(?<![\\\\w])(on_face)(?![\\\\w?!])",
      "name": "support.function.workplane.kupcad"
    },
    "inspections": {
      "match": "(?<![\\\\w])(bbox|volume|surface_area|min_gap|contains?|ray_cast)(?![\\\\w?!])",
      "name": "support.function.inspection.kupcad"
    },
    "hash_keys": {
      "match": "\\b([a-zA-Z_]\\w*[!?]?)(:)(?!:)",
      "captures": {
        "1": {
          "name": "constant.language.symbol.hashkey.kupcad"
        },
        "2": {
          "name": "punctuation.separator.key-value.kupcad"
        }
      }
    },
    "method_declarations": {
      "match": "(?:^|\\s)(def)\\s+([a-zA-Z_]\\w*[!?]?)",
      "captures": {
        "1": {
          "name": "keyword.control.def.kupcad"
        },
        "2": {
          "name": "entity.name.function.kupcad"
        }
      }
    },
    "block_parameters": {
      "begin": "(?<=\\bdo\\b|\\{)\\s*(\\|)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.variable.kupcad"
        }
      },
      "end": "(\\|)",
      "endCaptures": {
        "1": {
          "name": "punctuation.separator.variable.kupcad"
        }
      },
      "name": "meta.block.parameters.kupcad",
      "patterns": [
        {
          "match": "[a-zA-Z_]\\w*",
          "name": "variable.parameter.block.kupcad"
        },
        {
          "match": ",",
          "name": "punctuation.separator.object.kupcad"
        }
      ]
    }
  }
}