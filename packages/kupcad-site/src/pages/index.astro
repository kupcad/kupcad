---
import Page from '../layouts/Page.astro';
---

<Page title="KupCAD">
  <main>
    <h1>KupCAD</h1>
    <p>Code to CAD: a script in, a model out.</p>
    <p><a href="/playground">Try it in the playground</a>, in your browser.</p>
  </main>
</Page>

<style>
  main {
    max-width: 40em;
    margin: 0 auto;
    padding: 2em 1em;
  }
  a {
    color: var(--kc-accent);
  }
</style>
