{
  "name": "@kupcad/ui",
  "version": "0.1.0",
  "private": true,
  "description": "The Svelte panels a KupCAD host shows beside its editor: the viewer with its toolbar and part list, and the parameter panel, styled by --kc-* tokens.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./vscode.css": "./src/vscode.css"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@kupcad/protocol": "workspace:*",
    "@kupcad/viewer": "workspace:*"
  },
  "devDependencies": {
    "@kupcad/wasm": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
