{
  "name": "@kupcad/wasm",
  "version": "0.1.3",
  "description": "The KupCAD core compiled to WebAssembly: preview, build, check, format and read the parameters of a script in the browser or Node, directly or in a Web Worker.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kupcad/kupcad.git",
    "directory": "packages/kupcad-wasm"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "dist/kupcad.wasm"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#read-file": {
      "node": "./src/read-file.node.js",
      "default": "./src/read-file.browser.js"
    }
  },
  "exports": {
    ".": "./src/index.js",
    "./types": {
      "types": "./src/types.d.ts"
    },
    "./testing": "./src/testing.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/copy-wasm.js",
    "check": "tsc -p jsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kupcad/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
