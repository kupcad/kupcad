{
  "name": "@kupcad/viewer",
  "version": "0.1.0",
  "private": true,
  "description": "KupCAD's viewer: a three.js scene of a model the core made (GLB) or a drawing (SVG), with render modes, views, a section plane and part picking, and a Svelte component around it.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "./src/testing.js"
  ],
  "exports": {
    ".": "./src/index.js",
    "./svelte": {
      "svelte": "./src/svelte.js",
      "default": "./src/svelte.js"
    },
    "./types": {
      "types": "./src/types.d.ts"
    },
    "./testing": "./src/testing.js"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@kupcad/protocol": "workspace:*",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@kupcad/wasm": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "@types/three": "~0.186.0",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
