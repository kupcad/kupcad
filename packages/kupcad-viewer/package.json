{
  "name": "@kupcad/viewer",
  "version": "0.1.0",
  "description": "KupCAD's viewer: a three.js scene of a model the core made (GLB) or a drawing (SVG), with render modes, views, a section plane and part picking, and a Svelte component around it.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kupcad/kupcad.git",
    "directory": "packages/kupcad-viewer"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.test-helper.*"
  ],
  "type": "module",
  "sideEffects": [
    "./src/testing.js"
  ],
  "exports": {
    ".": "./src/index.js",
    "./svelte": {
      "svelte": "./src/svelte.js",
      "default": "./src/svelte.js"
    },
    "./types": {
      "types": "./src/types.d.ts"
    },
    "./testing": "./src/testing.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@kupcad/protocol": "workspace:*",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@kupcad/wasm": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "@types/three": "~0.186.0",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
