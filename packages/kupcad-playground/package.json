{
  "name": "@kupcad/playground",
  "version": "0.1.6",
  "description": "KupCAD in the browser: a script's editor, its model and its parameters, running on the core compiled to WebAssembly in a worker. One Svelte component a page embeds.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kupcad/kupcad.git",
    "directory": "packages/kupcad-playground"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.test-helper.*"
  ],
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config dev/vite.config.js",
    "check": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@kupcad/editor": "workspace:*",
    "@kupcad/protocol": "workspace:*",
    "@kupcad/ui": "workspace:*",
    "@kupcad/wasm": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.43.15",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
