{
  "name": "@kupcad/playground",
  "version": "0.1.0",
  "private": true,
  "description": "KupCAD in the browser: a script's editor, its model and its parameters, running on the core compiled to WebAssembly in a worker. One Svelte component a page embeds.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@kupcad/editor": "workspace:*",
    "@kupcad/protocol": "workspace:*",
    "@kupcad/ui": "workspace:*",
    "@kupcad/viewer": "workspace:*",
    "@kupcad/wasm": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.43.15",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  }
}
