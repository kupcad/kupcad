{
  "name": "@kupcad/vscode",
  "displayName": "KupCAD",
  "version": "0.1.1",
  "private": true,
  "description": "KupCAD - code to CAD language",
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages",
    "Visualization"
  ],
  "publisher": "kupcad",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vite build --config vite.config.extension.js && vite build --config vite.config.webview.js",
    "watch": "concurrently \"vite build --config vite.config.extension.js --watch\" \"vite build --config vite.config.webview.js --watch\"",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings"
  },
  "devDependencies": {
    "@kupcad/protocol": "workspace:*",
    "@kupcad/ui": "workspace:*",
    "@kupcad/wasm": "workspace:*",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/protobuf-specs": "0.5.2",
    "@sigstore/tuf": "5.0.0",
    "@sigstore/verify": "4.1.2",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "~1.140.0",
    "concurrently": "^10.0.6",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vscode-languageclient": "^11.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "kupcad.openViewer",
        "title": "Open Viewer",
        "category": "KupCAD",
        "icon": "$(preview)"
      },
      {
        "command": "kupcad.export",
        "title": "Export…",
        "category": "KupCAD"
      },
      {
        "command": "kupcad.updateCli",
        "title": "Update CLI",
        "category": "KupCAD"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kupcad.openViewer",
          "when": "resourceLangId == kupcad",
          "group": "navigation"
        },
        {
          "command": "kupcad.export",
          "when": "resourceLangId == kupcad",
          "group": "kupcad@1"
        },
        {
          "command": "kupcad.updateCli",
          "when": "resourceLangId == kupcad",
          "group": "kupcad@2"
        }
      ]
    },
    "configuration": {
      "title": "KupCAD",
      "properties": {
        "kupcad.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the `kupcad` executable, run whatever its version. When empty, the extension runs its own install (downloading the newest release it runs with), else `kupcad` on PATH, else the monorepo's build, each only when its version is one the extension runs with."
        },
        "kupcad.binary.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Install a newer release of kupcad at once when one is out (looked for once a day), instead of asking first. Only the extension's own install is updated. The KupCAD: Update CLI command looks at once."
        },
        "kupcad.binary.channel": {
          "type": "string",
          "enum": [
            "stable",
            "prerelease"
          ],
          "default": "stable",
          "description": "Which releases of kupcad the extension installs: `prerelease` takes the release candidates too."
        },
        "kupcad.viewport.port": {
          "type": "integer",
          "default": 9001,
          "minimum": 0,
          "maximum": 65535,
          "description": "Preferred port for the local viewport WebSocket (0 = always pick a free port). If taken, the server falls back to a free port automatically."
        }
      }
    },
    "languages": [
      {
        "id": "kupcad",
        "aliases": [
          "KupCAD",
          "kupcad"
        ],
        "extensions": [
          ".kup"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kupcad",
        "scopeName": "source.kupcad",
        "path": "./syntaxes/kupcad.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.125.0"
  },
  "kupcad": {
    "core": ">=0.1.0 <0.2.0"
  }
}
