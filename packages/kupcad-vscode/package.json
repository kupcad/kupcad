{
  "name": "@kupcad/vscode",
  "displayName": "KupCAD",
  "version": "0.1.0",
  "private": true,
  "description": "KupCAD - code to CAD language",
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages",
    "Visualization"
  ],
  "publisher": "kupcad",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vite build --config vite.config.extension.js && vite build --config vite.config.webview.js",
    "watch": "concurrently \"vite build --config vite.config.extension.js --watch\" \"vite build --config vite.config.webview.js --watch\"",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings"
  },
  "devDependencies": {
    "@kupcad/protocol": "workspace:*",
    "@kupcad/ui": "workspace:*",
    "@kupcad/viewer": "workspace:*",
    "@kupcad/wasm": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "~1.125.0",
    "concurrently": "^10.0.6",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vscode-languageclient": "^10.1.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "kupcad.openViewer",
        "title": "Open Viewer",
        "category": "KupCAD",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kupcad.openViewer",
          "when": "resourceLangId == kupcad",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "KupCAD",
      "properties": {
        "kupcad.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the `kupcad` executable. When empty, `kupcad` is looked up on PATH, then the monorepo dev build."
        },
        "kupcad.viewport.port": {
          "type": "integer",
          "default": 9001,
          "minimum": 0,
          "maximum": 65535,
          "description": "Preferred port for the local viewport WebSocket (0 = always pick a free port). If taken, the server falls back to a free port automatically."
        }
      }
    },
    "languages": [
      {
        "id": "kupcad",
        "aliases": [
          "KupCAD",
          "kupcad"
        ],
        "extensions": [
          ".kup"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kupcad",
        "scopeName": "source.kupcad",
        "path": "./syntaxes/kupcad.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.125.0"
  }
}
