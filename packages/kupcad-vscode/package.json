{
  "name": "@kupcad/vscode",
  "displayName": "KupCAD",
  "version": "0.1.0",
  "private": true,
  "description": "KupCAD - code to CAD language",
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages",
    "Visualization"
  ],
  "publisher": "kupcad",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "dev:backend": "vite build --config vite.config.node.js --watch",
    "dev:frontend": "vite --config webview/vite.config.js",
    "watch": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "vite build --config vite.config.node.js && vite build --config webview/vite.config.js",
    "test": "vitest run",
    "check": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "~1.125.0",
    "concurrently": "^10.0.6",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "contributes": {
    "commands": [
      {
        "command": "kupcad.showUI",
        "title": "KupCAD: Open Viewer"
      }
    ],
    "configuration": {
      "title": "KupCAD",
      "properties": {
        "kupcad.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the `kupcad` executable. When empty, `kupcad` is looked up on PATH, then the monorepo dev build."
        },
        "kupcad.viewport.port": {
          "type": "integer",
          "default": 9001,
          "minimum": 0,
          "maximum": 65535,
          "description": "Preferred port for the local viewport WebSocket (0 = always pick a free port). If taken, the server falls back to a free port automatically."
        }
      }
    },
    "languages": [
      {
        "id": "kupcad",
        "aliases": [
          "KupCAD",
          "kupcad"
        ],
        "extensions": [
          ".kup"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kupcad",
        "scopeName": "source.kupcad",
        "path": "./syntaxes/kupcad.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.125.0"
  }
}
