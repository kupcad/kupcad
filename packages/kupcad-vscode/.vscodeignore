# What the packaged extension leaves out: it runs dist/extension.cjs (the language client bundled
# in) and the page in dist-webview/, nothing else of this folder.
.vscode/**
.gitignore
src/**
*.config.js
jsconfig.json
node_modules/**
**/*.map
# three's Draco decoder, which the build copies in: the language server sends no Draco model
dist-webview/assets/draco_*
